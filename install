#!/usr/bin/env bash
set -euo pipefail

REPOSITORY="koteyye/KoteCode"
VERSION="${VERSION:-}"
INSTALL_DIR="${KOTECODE_INSTALL_DIR:-$HOME/.local/bin}"
LOCAL_BINARY=""

usage() {
  cat <<'EOF'
KoteCode installer

Usage: install [--version VERSION] [--install-dir DIR] [--binary FILE]

Downloads a KoteCode release from GitHub, verifies it against SHA256SUMS,
and installs it without sudo. VERSION may include or omit the leading "v".
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--version)
      VERSION="${2:?--version requires a value}"
      shift 2
      ;;
    --install-dir)
      INSTALL_DIR="${2:?--install-dir requires a value}"
      shift 2
      ;;
    -b|--binary)
      LOCAL_BINARY="${2:?--binary requires a value}"
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

mkdir -p "$INSTALL_DIR"

if [[ -n "$LOCAL_BINARY" ]]; then
  [[ -f "$LOCAL_BINARY" ]] || { echo "Binary not found: $LOCAL_BINARY" >&2; exit 1; }
  temporary="$INSTALL_DIR/.kotecode.new.$$"
  cp "$LOCAL_BINARY" "$temporary"
  chmod 755 "$temporary"
  smoke_dir="$(mktemp -d "${TMPDIR:-/tmp}/kotecode-smoke.XXXXXX")"
  trap 'rm -rf "$smoke_dir"; rm -f "$temporary"' EXIT
  env \
    XDG_DATA_HOME="$smoke_dir/data" \
    XDG_CACHE_HOME="$smoke_dir/cache" \
    XDG_CONFIG_HOME="$smoke_dir/config" \
    XDG_STATE_HOME="$smoke_dir/state" \
    "$temporary" --version >/dev/null
  mv -f "$temporary" "$INSTALL_DIR/kotecode"
  rm -rf "$smoke_dir"
  trap - EXIT
  echo "Installed local KoteCode binary to $INSTALL_DIR/kotecode"
  exit 0
fi

command -v curl >/dev/null 2>&1 || { echo "curl is required" >&2; exit 1; }
command -v unzip >/dev/null 2>&1 || { echo "unzip is required" >&2; exit 1; }

case "$(uname -s)" in
  Darwin) platform="darwin" ;;
  Linux) platform="linux" ;;
  *) echo "Unsupported operating system: $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  arm64|aarch64) arch="arm64" ;;
  x86_64|amd64) arch="x64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

asset="kotecode-${platform}-${arch}.zip"
if [[ -n "$VERSION" ]]; then
  VERSION="${VERSION#v}"
  [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]] || {
    echo "Invalid version: $VERSION" >&2
    exit 1
  }
  base="https://github.com/$REPOSITORY/releases/download/v$VERSION"
else
  base="https://github.com/$REPOSITORY/releases/latest/download"
fi

temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/kotecode-install.XXXXXX")"
trap 'rm -rf "$temporary_dir"' EXIT

curl --fail --silent --show-error --location "$base/SHA256SUMS" --output "$temporary_dir/SHA256SUMS"
curl --fail --silent --show-error --location "$base/$asset" --output "$temporary_dir/$asset"

expected="$(awk -v name="$asset" '$2 == name || $2 == "*" name { print tolower($1); exit }' "$temporary_dir/SHA256SUMS")"
[[ "$expected" =~ ^[0-9a-f]{64}$ ]] || { echo "No valid checksum for $asset" >&2; exit 1; }

if command -v sha256sum >/dev/null 2>&1; then
  actual="$(sha256sum "$temporary_dir/$asset" | awk '{print tolower($1)}')"
else
  actual="$(shasum -a 256 "$temporary_dir/$asset" | awk '{print tolower($1)}')"
fi
[[ "$actual" == "$expected" ]] || { echo "Checksum mismatch for $asset" >&2; exit 1; }

unzip -q "$temporary_dir/$asset" -d "$temporary_dir/unpacked"
[[ -f "$temporary_dir/unpacked/kotecode" ]] || { echo "$asset does not contain kotecode" >&2; exit 1; }
chmod 755 "$temporary_dir/unpacked/kotecode"
env \
  XDG_DATA_HOME="$temporary_dir/data" \
  XDG_CACHE_HOME="$temporary_dir/cache" \
  XDG_CONFIG_HOME="$temporary_dir/config" \
  XDG_STATE_HOME="$temporary_dir/state" \
  "$temporary_dir/unpacked/kotecode" --version >/dev/null

temporary_binary="$INSTALL_DIR/.kotecode.new.$$"
cp "$temporary_dir/unpacked/kotecode" "$temporary_binary"
chmod 755 "$temporary_binary"
mv -f "$temporary_binary" "$INSTALL_DIR/kotecode"

echo "Installed KoteCode to $INSTALL_DIR/kotecode"
case ":$PATH:" in
  *":$INSTALL_DIR:"*) ;;
  *)
    echo "Add KoteCode to PATH, then restart your shell:"
    echo "  export PATH=\"$INSTALL_DIR:\$PATH\""
    ;;
esac
